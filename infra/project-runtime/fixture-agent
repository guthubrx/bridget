#!/bin/sh
# Adaptateur ACP minimal, exclusivement pour le test d'intégration SPEC-066.
# Il ne contacte aucun fournisseur, ne lit aucune clé et n'est jamais inscrit
# dans le registre utilisateur.
set -eu

IFS= read -r initialize || exit 1
printf '%s\n' '{"jsonrpc":"2.0","id":1,"result":{"protocolVersion":1}}'
IFS= read -r session || exit 1
printf '%s\n' '{"jsonrpc":"2.0","id":2,"result":{"sessionId":"spec-066-fixture"}}'

# La fermeture de test passe par `managed-runtime-stop`, jamais par la CLI
# Docker ni par un signal transmis depuis l'hôte.
trap 'exit 0' TERM INT
while :; do
  sleep 1
done
