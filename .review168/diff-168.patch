+fn cmd_delegate_catalogue(args: &[String]) {
+    let mut machine = None;
+    let mut json_output = false;
+    let mut index = 0;
+    while index < args.len() {
+        match args[index].as_str() {
+            "--json" if !json_output => json_output = true,
+            "--machine" if machine.is_none() => {
+                machine = Some(option_value(args, &mut index, "--machine").unwrap_or_else(
+                    |error| {
+                        exit_coordination_error(
+                            "delegate",
+                            json_output,
+                            "invalid_arguments",
+                            &error,
+                            None,
+                            2,
+                        )
+                    },
+                ));
+            }
+            option => exit_coordination_error(
+                "delegate",
+                json_output,
+                "invalid_arguments",
+                &unknown_argument("delegate --catalogue", option),
+                None,
+                2,
+            ),
+        }
+        index += 1;
+    }
+    let result =
+        crate::communication::client::routing_catalogue(&DaemonConfig::default().socket_path)
+            .unwrap_or_else(|error| {
+                exit_coordination_error(
+                    "delegate",
+                    json_output,
+                    "capability_unavailable",
+                    &error.to_string(),
+                    None,
+                    1,
+                )
+            });
+    let options = result
+        .get("options")
+        .and_then(serde_json::Value::as_array)
+        .ok_or_else(|| "routing_catalogue_invalid".to_string())
+        .and_then(|options| {
+            let options = options
+                .iter()
+                .filter(|option| {
+                    machine.as_deref().is_none_or(|id| {
+                        option.get("machine_id").and_then(serde_json::Value::as_str) == Some(id)
+                    })
+                })
+                .cloned()
+                .collect::<Vec<_>>();
+            (options.len() <= 128)
+                .then_some(options)
+                .ok_or_else(|| "routing_catalogue_invalid".to_string())
+        })
+        .unwrap_or_else(|error| {
+            exit_coordination_error(
+                "delegate",
+                json_output,
+                "catalogue_invalid",
+                &error,
+                None,
+                1,
+            )
+        });
+    if json_output {
+        let mut result = result;
+        result["options"] = serde_json::Value::Array(options);
+        println!("{result}");
+        return;
+    }
+    println!("machine\tmoteur\tconnexion\tmodèle\tefforts\tdéfaut\tprovenance");
+    for option in options {
+        let text = |key| {
+            option
+                .get(key)
+                .and_then(serde_json::Value::as_str)
+                .unwrap_or("?")
+        };
+        let efforts = option
+            .get("supported_efforts")
+            .and_then(serde_json::Value::as_array)
+            .map(|values| {
+                values
+                    .iter()
+                    .filter_map(serde_json::Value::as_str)
+                    .collect::<Vec<_>>()
+                    .join(",")
+            })
+            .unwrap_or_default();
+        println!(
+            "{}\t{}\t{}\t{}\t{}\t{}\t{}",
+            text("machine_id"),
+            text("engine"),
+            text("connection_id"),
+            text("model"),
+            efforts,
+            option
+                .get("default_effort")
+                .and_then(serde_json::Value::as_str)
+                .unwrap_or("natif"),
+            text("provenance")
+        );
+    }
+}
