+    fn spec168_permis_reste_detenu_apres_timeout_demandeur_jusqu_au_drain_reel() {
+        use bridget_transport::{
+            ClaudeIsolatedDecisionError, ClaudeIsolatedDecisionOptions,
+            run_isolated_claude_decision,
