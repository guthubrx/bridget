+pub(crate) fn queue_edit_refusal_code(refusal: crate::guidance::GuidanceRefusal) -> String {
+    let (code, reason) = guidance_refusal_fields(refusal);
+    if code == "intent_not_permitted" { format!("{code}:{reason}") } else { code.into() }
