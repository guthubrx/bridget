+    pub(crate) fn queue_edit_once<T>(
+        &mut self,
+        issuer_scope: &str,
+        request_id: &str,
+        canonical_bytes: &[u8],
+        action: bridget_transport::protocol::QueueEditAction,
+        actor: &str,
