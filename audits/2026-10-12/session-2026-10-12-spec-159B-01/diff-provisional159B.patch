+// State est tenu par le caller jusqu'au COMMIT; le reçu seul ne prouve aucun droit.
+#[allow(clippy::too_many_arguments)]
+fn handle_queue_edit(
+    st: &mut DaemonState, conn: &str, request_id: String, target: String,
+    action: bridget_transport::protocol::QueueEditAction, message_id: String,
+    before_message_id: Option<String>,
+) -> (DaemonToWrapper, Option<crate::idempotency::OrphanedDeliveryNotice>) {
+    use bridget_transport::protocol::{QueueEditAction, QueueEditState};
+    let failed = |id: &str| DaemonToWrapper::Nack { id: id.into(), reason: "queue_edit_storage_unavailable".into() };
+    if action == QueueEditAction::Promote {
+        return (DaemonToWrapper::Nack { id: request_id, reason: "unsupported_operation".into() }, None);
+    }
+    let Some(negotiated) = st.client_negotiations.get(conn) else {
+        return (DaemonToWrapper::ClientRejected { reason: ClientRefusal::NegotiationRequired }, None);
+    };
+    let scope = negotiated.issuer_scope.clone();
+    let recipient = routing_agent_id(&target).to_string();
+    let mut facts = match guidance_facts(st, Some(conn), &recipient,
+        match action {
+            QueueEditAction::Cancel => crate::guidance::GuidanceAction::QueueCancel,
+            QueueEditAction::Reorder => crate::guidance::GuidanceAction::QueueReorder,
+            QueueEditAction::Promote => unreachable!("promotion traitée par T021"),
+        }, crate::guidance::GuidancePath::Cancel, None, false, unix_now_secs()) {
+        Ok(facts) => facts,
+        Err(error) => { warn!("faits d'édition indisponibles: {error}"); return (failed(&request_id), None); }
+    };
+    let (actor, identity, _) = guidance_source(st, Some(conn));
+    let actor_label = match &actor {
+        crate::guidance::GuidanceActor::Agent { id } => id.clone(),
+        crate::guidance::GuidanceActor::AttachedHuman => "human".into(),
+        _ => "unattested".into(),
+    };
+    if let Some((agent, _)) = identity {
+        facts.actor_is_author = match queue_edit_actor_is_author(st, &scope, &request_id, &recipient, &message_id, &agent) {
+            Ok(author) => author,
+            Err(error) => { warn!("preuve auteur indisponible: {error}"); return (failed(&request_id), None); }
+        };
+    }
+    if let Err(refusal) = crate::guidance::authorize(&facts) {
+        return (DaemonToWrapper::QueueEditResult {
+            request_id, state: QueueEditState::Refused,
+            refusal: Some(queue_edit_refusal_code(refusal)), effect: None,
+        }, None);
+    }
+    let canon = match serde_json::to_vec(&serde_json::json!({
+        "action": action, "target": recipient, "message_id": message_id, "before_message_id": before_message_id,
+    })) {
+        Ok(canon) => canon,
+        Err(error) => { warn!("canon d'édition indisponible: {error}"); return (failed(&request_id), None); }
+    };
+    let result = match action {
+        QueueEditAction::Cancel => st.idempotency.apply_cancel(&scope, &request_id, &canon, &actor_label, &recipient, &message_id, unix_now_secs()),
+        QueueEditAction::Reorder => st.idempotency.apply_reorder(&scope, &request_id, &canon, &actor_label, &recipient, &message_id, before_message_id.as_deref(), unix_now_secs())
+            .map(|(receipt, _fresh)| (receipt, None)),
+        QueueEditAction::Promote => unreachable!("promotion traitée par T021"),
+    };
+    match result {
+        Ok((receipt, notice)) => {
+            if let Some(notice) = &notice {
+                st.held_ids.remove(&notice.message_id);
+                st.pending_replies.retain(|pending| pending.msg_id != notice.message_id);
+            }
+            (DaemonToWrapper::QueueEditResult {
+                request_id, state: receipt.state, refusal: receipt.refusal, effect: receipt.effect,
+            }, notice)
+        }
+        Err(error) => { warn!("transaction d'édition refusée: {error}"); (failed(&request_id), None) }
+    }
+}
