+    assert!(edit159_observed(&f,"turn156").is_empty());
+    assert_eq!(edit159_row(&db,"edit159-C").0,"cancelled");
+    assert_eq!(edit159_row(&db,"edit159-D").0,"dispatching");
+    for (i,id) in ["edit159-A","edit159-B","edit159-C","edit159-D"].iter().enumerate() {
+        let row=edit159_row(&db,id);assert_eq!(row.5,originals[i].5,"canon initial figé {id}");assert_eq!((&row.1,row.2,&row.3),(&originals[i].1,originals[i].2,&originals[i].3),"canon/enveloppe/ID/génération figés {id}");
