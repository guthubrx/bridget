+        Ok(page) => serde_json::from_value(page).unwrap_or(
+            DaemonToWrapper::DelegationControlRejected { reason: E::StoreUnavailable },
+        ),
+        Err(reason) => DaemonToWrapper::DelegationControlRejected { reason },
+    }
+}
