+        && p.last_attested_at
+            .is_some_and(|at| now.saturating_duration_since(at) <= Duration::from_secs(90));
+    let forced = p
+        .last_attested_at
+        .is_some_and(|at| now.saturating_duration_since(at) > Duration::from_secs(90))
+        && p.busy_period_start.is_some_and(|at| {
