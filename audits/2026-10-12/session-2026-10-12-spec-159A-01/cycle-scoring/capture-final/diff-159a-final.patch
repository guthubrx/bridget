+            Err(SchemaError::UnsupportedVersion {
+                found: 8,
+                supported: 7
+            })
+        ),
+        "v8 doit rester fermée ; elle ne doit être ni migrée ni réparée"
+    );
+    assert_eq!(conn.total_changes(), before);
