+        assert!(matches!(
+            sender.receive(),
+            DaemonToWrapper::IdempotencyResult {
+                issue: IdempotencyIssue::Accepted { .. }
+                    | IdempotencyIssue::OutcomeUnknown {
+                        delivery_id: Some(_),
+                        ..
+                    },
