+                        .map_err(|_| std::io::Error::from(std::io::ErrorKind::WouldBlock))?;
+                    Ok(guard(&st, &conn, &context).err().map(|e| {
+                        refused = Some(e);
+                        DaemonToWrapper::HumanLineageResult { result: e.result() }
+                    }))
+                },
+            );
+            sent.map_err(|_| E::BindingUnavailable)?;
+            if let Some(e) = refused {
+                return Err(e);
+            }
+            Ok(())
