+        let settings_paths = if path.is_dir() {
+            std::fs::read_dir(path)
+                .map_err(|_| unavailable())?
+                .take(257)
+                .map(|entry| entry.map(|entry| entry.path()).map_err(|_| unavailable()))
+                .collect::<Result<Vec<_>, _>>()?
