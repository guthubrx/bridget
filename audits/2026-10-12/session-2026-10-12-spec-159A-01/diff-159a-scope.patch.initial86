+fn terminate(watch: &mut Watch, code: E) {
+    if watch.terminal {
+        return;
+    }
+    watch.pending.clear();
+    watch.pending.push_back(Event::Error { version: 1, code });
+    watch.terminal = true;
+    let _ = watch.notify.try_send(());
 }
 
