 #[test]
 fn native154_git_delai_termine_son_enfant() {
-    isolated("slow", "workspace_git::tests::native154_git_delai_termine_son_enfant", |root| {
-        let started = Instant::now();
-        let error = run_git(&root.join("repo"), &["status", "--porcelain=v1", "--untracked-files=normal"], Duration::from_millis(100)).unwrap_err();
-        assert!(error.contains("délai Git dépassé"));
-        assert!(started.elapsed() < Duration::from_secs(1));
-        let pid = fs::read_to_string(root.join("git.pid")).unwrap().parse::<i32>().unwrap();
-        assert_eq!(unsafe { libc::kill(pid, 0) }, -1, "le seul enfant Git lancé doit être terminé/récolté");
-        assert_eq!(io::Error::last_os_error().raw_os_error(), Some(libc::ESRCH));
-    });
+    isolated(
+        "slow",
+        "workspace_git::tests::native154_git_delai_termine_son_enfant",
+        |root| {
+            let started = Instant::now();
+            let error = run_git(
+                &root.join("repo"),
+                &["status", "--porcelain=v1", "--untracked-files=normal"],
+                Duration::from_millis(100),
+            )
+            .unwrap_err();
+            assert!(error.contains("délai Git dépassé"));
+            assert!(started.elapsed() < Duration::from_secs(1));
+            let pid = fs::read_to_string(root.join("git.pid"))
+                .unwrap()
+                .parse::<i32>()
+                .unwrap();
+            assert_eq!(
+                unsafe { libc::kill(pid, 0) },
+                -1,
+                "le seul enfant Git lancé doit être terminé/récolté"
+            );
+            assert_eq!(io::Error::last_os_error().raw_os_error(), Some(libc::ESRCH));
+        },
+    );
 }
 
