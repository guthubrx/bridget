+        }
         if Instant::now() >= deadline {
-            let observed = Command::new("/bin/ps").args(["-p", &child.id().to_string(), "-o", "command="]).output().unwrap();
-            assert!(String::from_utf8_lossy(&observed.stdout).trim().starts_with(&executable.display().to_string()));
