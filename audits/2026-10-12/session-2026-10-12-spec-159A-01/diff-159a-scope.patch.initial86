+            if let Some(notice) = st
+                .idempotency
+                .settle_held(&delivery_id, reason, now)
+                .map_err(|error| error.to_string())?
+            {
+                st.held_ids.remove(&notice.message_id);
+                st.pending_replies
+                    .retain(|pending| pending.msg_id != notice.message_id);
+            }
+        }
+    }
+    Ok(())
+}
