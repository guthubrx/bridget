+pub(super) fn invalid_message(st: &mut DaemonState, conn: &str) -> bool {
+    if let Some(w) = st.lineage_watches.get_mut(conn) {
+        terminate(w, E::InvalidRequest);
+        return true;
+    }
+    if let Some(j) = st.lineage_journals.get(conn) {
+        let _ = j.notify.try_send(());
