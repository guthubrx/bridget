+            held159_release_phase(&f.shared, &f.delivery_id),
+            "cancelled"
+        );
+        assert!(
+            !f.shared
+                .lock()
+                .unwrap()
+                .pending_replies
+                .iter()
+                .any(|p| p.msg_id == f.message.id)
