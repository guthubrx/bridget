-        if let Some(state)=weak.upgrade(){state.lock().unwrap_or_else(|e|e.into_inner()).lineage_journals.remove(&conn);}
-        let _=shutdown.shutdown(std::net::Shutdown::Both);
+        let _ = shutdown.shutdown(std::net::Shutdown::Both);
     });
     None
 }
