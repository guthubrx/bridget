+    let script = format!(
+        "#!{}\nimport sys, os, time, json\nroot={}\nargs=sys.argv[1:]\nif '--version' in args:\n print('git version {}'); sys.exit(0)\nif os.path.exists(root+'/arm'):\n with open(root+'/git-commands', 'a') as log: log.write(json.dumps(args)+'\\n')\n slow=(('worktree' in args and 'add' in args) if {} else ('log' in args))\n if slow and {}:\n  open(root+'/started','w').write(str(os.getpid()))\n  time.sleep({})\nos.execv({}, [{}]+args)\n",
+        python.display(),
+        serde_json::to_string(root.to_str().unwrap()).unwrap(),
         if case == "old" { "2.43.0" } else { "2.55.0" },
-        if case == "report" { "False" } else { "True" }, delay, delay,
-        serde_json::to_string(git.to_str().unwrap()).unwrap(), serde_json::to_string(git.to_str().unwrap()).unwrap());
+        if case == "report" { "False" } else { "True" },
