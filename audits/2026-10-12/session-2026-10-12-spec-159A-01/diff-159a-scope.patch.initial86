+            let error = weak
+                .upgrade()
+                .and_then(|s| {
+                    guard(
+                        &s.lock().unwrap_or_else(|e| e.into_inner()),
+                        &conn,
+                        &context,
+                    )
+                    .err()
+                })
+                .unwrap_or(error);
+            let _ = emit(error.result());
+        }
+        if let Some(state) = weak.upgrade() {
+            state
+                .lock()
+                .unwrap_or_else(|e| e.into_inner())
+                .lineage_journals
+                .remove(&conn);
