+fn security_source_is_observable(path: &Path) -> Result<(), String> {
+    if !path.is_file() {
+        return Ok(());
+    }
+    let value = read_json_source(path)?;
+    if ["policyHelper", "policyHelpers", "processWrapper", "hooks"]
+        .iter()
+        .any(|key| value.get(*key).is_some())
+    {
+        return Err(unavailable());
+    }
     Ok(())
 }
 
