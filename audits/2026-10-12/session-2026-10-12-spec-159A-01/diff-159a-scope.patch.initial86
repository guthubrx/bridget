+            let commands: Vec<Vec<String>> = fs::read_to_string(root.join("git-commands"))
+                .unwrap()
+                .lines()
+                .map(|line| serde_json::from_str(line).unwrap())
+                .collect();
+            assert!(!commands.is_empty(), "la vraie fin doit lire Git");
+            for args in &commands {
+                for forbidden in [
+                    "remove",
+                    "--force",
+                    "branch",
+                    "-d",
+                    "-D",
+                    "update-ref",
+                    "reset",
+                    "clean",
+                    "checkout",
+                    "push",
+                    "fetch",
+                    "merge",
+                ] {
+                    assert!(
+                        !args.iter().any(|arg| arg == forbidden),
+                        "commande interdite : {args:?}"
+                    );
+                }
+                assert!(
+                    args.iter().any(|arg| [
+                        "rev-parse",
+                        "symbolic-ref",
+                        "config",
+                        "rev-list",
+                        "log",
+                        "status"
