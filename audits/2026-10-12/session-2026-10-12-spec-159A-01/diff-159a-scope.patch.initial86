+        |_| {
+            let fixture = fixture154("old-git");
+            let before = footprint154(&fixture);
+            assert_eq!(
+                call154(
+                    &fixture,
+                    request154(&fixture.root, "old", Some(json!({"strategy":"worktree"})))
+                )["code"],
+                "workspace_git_unsupported"
+            );
+            assert_eq!(footprint154(&fixture), before);
+        },
+    );
 }
 
