+        let nested = create(&preflight(worktree, None, None).unwrap(), &uuid::Uuid::new_v4().to_string()).unwrap();
+        fixture_git(Path::new(&nested.path), &["commit", "--allow-empty", "-qm", "nested head"]);
+        let nested_expected = report(&nested).unwrap().head_commit.unwrap();
+        // Les deux .git sont désormais mensongers. Le registre du principal
+        // reste autorité ; aucune lecture ne doit suivre ces fichiers.
+        fs::write(worktree.join(".git"), format!("gitdir: {}\n", repo.join(".git").display())).unwrap();
+        fs::write(Path::new(&nested.path).join(".git"), format!("gitdir: {}\n", repo.join(".git").display())).unwrap();
+        assert_eq!(report(&record).unwrap().head_commit.as_deref(), Some(expected.as_str()));
+        assert_eq!(report(&nested).unwrap().head_commit.as_deref(), Some(nested_expected.as_str()));
+
