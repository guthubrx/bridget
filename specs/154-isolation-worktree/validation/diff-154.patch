+fn report_text(value: &str) -> String {
+    value.chars().flat_map(|c| if c.is_control() || bridget_core::is_disallowed_control(c) {
+        c.escape_unicode().collect::<Vec<_>>()
+    } else { vec![c] }).collect()
+}
