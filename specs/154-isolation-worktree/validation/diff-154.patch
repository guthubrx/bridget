+        let worker = std::thread::spawn(move || tick(&state));
+        let deadline = Instant::now() + Duration::from_secs(10);
+        while !root.join("started").exists() {
+            assert!(Instant::now() < deadline);
+            std::thread::sleep(Duration::from_millis(1));
