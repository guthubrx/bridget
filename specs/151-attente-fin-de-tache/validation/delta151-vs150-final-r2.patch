+fn validate_task_ids(ids: &[String]) -> Result<(), String> {
+    if ids.is_empty()
+        || ids.len() > 16
+        || ids.iter().any(|id| {
+            id.is_empty() || id.len() > 128 || id.chars().any(bridget_core::is_disallowed_control)
+        })
+        || ids.iter().collect::<HashSet<_>>().len() != ids.len()
+    {
