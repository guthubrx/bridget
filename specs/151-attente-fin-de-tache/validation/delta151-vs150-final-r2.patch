+                "native-failure-"
+            } else {
+                "native-result-"
+            };
+            let key = IdempotencyKey::new(
+                &crate::communication::issuer_scope(&task.task_id),
+                OperationKind::Send,
+                &format!("{prefix}{}", task.task_id),
+            )
+            .map_err(|e| e.to_string())?;
+            st.idempotency
+                .send_delivery_phase(&key)
+                .map_err(|e| e.to_string())?
+        } else {
+            None
+        };
+    Ok(task_view(task, phase.as_deref(), full))
