+                json!({"version":1,"timed_out":ready.is_empty(),"waited_secs":start.elapsed().as_secs(),"ready":ready,"pending":pending}),
+            );
+        }
+        epoch.wait_changed(
+            seen,
+            slice.min(deadline.saturating_duration_since(Instant::now())),
+        );
+    }
