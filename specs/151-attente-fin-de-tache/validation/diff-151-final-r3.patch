+            assert_eq!(
+                frames,
+                vec![
+                    json!({"type":"DaemonIdentityRequest"}),
+                    json!({"type":"RegisterAuxiliary"}),
+                    json!({"type":"NativeDelegation","request":{"operation":"ack","task_ids":ids}})
+                ]
