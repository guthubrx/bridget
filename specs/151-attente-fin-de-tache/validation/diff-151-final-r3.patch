+        pub(super) fn new(connection: &rusqlite::Connection, prefix: &'static [u8]) -> Self {
+            unsafe extern "C" fn observe(
+                event: u32,
+                context: *mut std::ffi::c_void,
+                _statement: *mut std::ffi::c_void,
+                sql: *mut std::ffi::c_void,
