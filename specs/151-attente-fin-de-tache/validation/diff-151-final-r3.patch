+pub(crate) fn request_reply_summary(message: &bridget_core::BridgetMessage) -> String {
+    let end = search::floor_char_boundary(&message.body, 1024);
+    serde_json::json!({
+        "id": message.id,
+        "from": message.from,
+        "summary": &message.body[..end],
+        "summary_truncated": end < message.body.len(),
+    })
+    .to_string()
