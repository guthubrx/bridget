+        let key = IdempotencyKey::new(CLI_WAKE_SCOPE, OperationKind::Send, id)?;
+        if owner.is_empty() || label.len() > 2048 {
+            return Err(IdempotencyError::InvalidDelivery);
+        }
+        let tx = self
+            .conn
+            .transaction_with_behavior(TransactionBehavior::Immediate)?;
