+                agent_type: "codex".to_string(),
+                host: "projet-a".to_string(),
+                transport: "tmux".to_string(),
+                channel: Some("ssh-unix".to_string()),
+                mode: Some(PresenceMode::Tmux),
+                location: None,
+                journal_available: false,
+                os: "Linux".to_string(),
