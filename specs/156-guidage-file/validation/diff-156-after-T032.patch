+fn provider_codex156() -> String {
+    r#"import json
+import os
+import sys
+import time
+
+evidence = os.path.join(os.path.dirname(os.path.abspath(__file__)), "evidence.jsonl")
+instance = os.environ["BRIDGET_AGENT_INSTANCE_ID"]
