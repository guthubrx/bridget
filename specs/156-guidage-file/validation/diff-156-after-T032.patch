+    assert!(
+        store
+            .queued_deliveries_for_recipient("new156", NOW + 5, 0)
+            .unwrap()
+            .is_empty()
+    );
+    assert!(
+        store
+            .queued_deliveries_for_recipient("old156", NOW + 5, 200)
+            .unwrap()
+            .is_empty()
+    );
+}
