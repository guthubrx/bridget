+        .unwrap();
+    assert_eq!(
+        oldest,
+        NOW - 86_400,
+        "strictement plus de24h, pas la borne exacte"
+    );
+    assert_eq!(store.record_count().unwrap(), 1);
+    assert_eq!(store.send_delivery(&key()).unwrap(), Some(delivery));
+    assert_eq!(
+        store
+            .queued_deliveries_for_recipient("legacy-instance150", NOW, 200)
+            .unwrap()
+            .len(),
+        1
+    );
+}
