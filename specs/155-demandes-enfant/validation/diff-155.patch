+            ..Default::default()
+        };
+        let (started_tx, started_rx) = std::sync::mpsc::sync_channel(1);
+        let cancel_worker = thread::spawn(move || {
+            started_tx.send(()).unwrap();
+            dispatch_managed_child_request(
+                &writer_cancel,
+                &mut cancel_session,
+                &mut cancel_bindings,
+                &requests_cancel,
+                cancel155(),
+            )
+        });
+        started_rx.recv_timeout(Duration::from_secs(1)).unwrap();
