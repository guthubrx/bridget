+                message,
+                response,
+                terminal: ManagedTerminal::Completed,
+            } => Some((message.id.as_str(), response.as_str())),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(
+        results,
+        vec![(
+            "background-mission",
+            "calcul en cours, rapport a venir\n\ntoujours en cours\n\nrapport final, commit termine"
+        )]
+    );
+    transport.stop();
+    let path = fs::read_dir(root.join("background271")).unwrap().next().unwrap().unwrap().path();
+    let records = crate::journal::valid_events(&path);
+    let results: Vec<_> = records.iter().filter(|r| r["event"] == "provider_result").collect();
+    assert_eq!(results.len(), 3);
+    assert_eq!(results[0]["payload"]["finalization"], "waiting_background_tasks");
+    assert_eq!(results[1]["payload"]["finalization"], "waiting_background_tasks");
+    assert_eq!(results[2]["payload"]["finalization"], "terminal_result");
+    assert!(results.iter().all(|r| r["message_id"] == "background-mission"));
+    fs::remove_dir_all(root).unwrap();
+}
 
