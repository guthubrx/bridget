+    let reasons = json!([{"kind":"candidate","code":"permissions_changed","candidates":1},
+        {"kind":"candidate","code":"permission_path_protected","candidates":2}]);
+    let result = failure(&format!("routing_candidate_unavailable:{reasons}"));
