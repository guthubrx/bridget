+        assert_eq!(st.idempotency.send_delivery_phase(&cle).unwrap(), None, "remise effacée");
+        for id in &ids {
+            assert!(st.delegation_store.get(id).unwrap().unwrap().delivery_acked, "{id}");
+        }
+        cleanup(&config);
+    }
