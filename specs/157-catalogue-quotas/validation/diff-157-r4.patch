+        "protocol": "codex_app_server", "forbidden_env": codex.forbidden_env,
+        "pass_env": codex.pass_env, "permissions": codex.permissions,
+        "capabilities": {"execution_paths": ["codex_app_server"],
+            "models": {"custom/model": {"efforts": ["high"]}}}
