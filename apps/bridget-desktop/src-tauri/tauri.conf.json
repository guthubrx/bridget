{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bridget Desktop",
  "version": "0.1.0",
  "identifier": "app.cartae.bridget-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bridget Desktop",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
