{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "relay-notification-permission",
  "description": "Le panneau de relais local peut seulement lire et demander l'autorisation native de notification.",
  "webviews": ["panel-*"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission"
  ]
}
